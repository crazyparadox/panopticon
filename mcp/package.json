{
  "name": "@panopticon/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Panopticon MCP server + sync ingest — Streamable HTTP MCP over the Neon-hosted activity timeline, deployable to Vercel.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/landing.html dist/landing.html",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@neondatabase/serverless": "^1.0.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
