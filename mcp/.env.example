# Neon Postgres connection string (from the Neon dashboard)
DATABASE_URL=postgres://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Shared bearer token — the Mac app pushes with it, MCP clients read with it.
# Generate one: openssl rand -hex 24
PANOPTICON_TOKEN=

# Local dev port (Vercel ignores this)
PORT=3939
